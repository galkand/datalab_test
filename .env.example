# Copy this file to .env before starting the platform.

# Airflow access to MinIO
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_DEFAULT_REGION=us-east-1
AIRFLOW_CONN_MINIO_S3=aws://minioadmin:minioadmin123@?endpoint_url=http%3A%2F%2Fminio%3A9000

# Spark S3A access to MinIO
S3A_ENDPOINT=http://minio:9000
S3A_ACCESS_KEY=minioadmin
S3A_SECRET_KEY=minioadmin123

# ClickHouse publication target
CH_HOST=clickhouse
CH_PORT=8123
CH_DB=analytics
CH_USER=analytics
CH_PASSWORD=analytics

# Local Spark defaults
SPARK_PROFILE=mvp
SPARK_SQL_SHUFFLE_PARTITIONS=32
