# Copy this file to .env and fill every empty secret before starting the platform.
# Use URL-safe values (for example, hex strings) because some values are embedded in connection URIs.

# MinIO (also used by Airflow and Spark)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Hive Metastore PostgreSQL
HIVE_METASTORE_DB_NAME=metastore
HIVE_METASTORE_DB_USER=hive
HIVE_METASTORE_DB_PASSWORD=

# Airflow PostgreSQL and local admin
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ClickHouse
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=

# Superset PostgreSQL, application key, and local admin
SUPERSET_DB_NAME=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=
SUPERSET_ADMIN_FIRSTNAME=Admin
SUPERSET_ADMIN_LASTNAME=User
SUPERSET_ADMIN_EMAIL=admin@example.com

# Local Spark defaults
SPARK_PROFILE=mvp
SPARK_SQL_SHUFFLE_PARTITIONS=32
